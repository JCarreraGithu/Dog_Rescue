# Copia este archivo como .env (local) y configura las mismas variables en Render.
# NUNCA subas el archivo .env a GitHub.

# Contraseña que usará el personal del refugio en /acceso
ADMIN_PASSWORD=tucontraseña

# Texto largo y aleatorio (mínimo 32 caracteres) para firmar las sesiones.
# Puedes generarlo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=pega-aqui-el-texto-aleatorio
