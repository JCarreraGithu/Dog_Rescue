# Copia este archivo como .env (local) y configura las mismas variables en Vercel.
# NUNCA subas el archivo .env a GitHub.

# Texto largo y aleatorio (32+ caracteres) para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=pega-aqui-el-texto-aleatorio

# Dominio compartido: no requiere ADMIN_ALLOWED_HOSTS ni ADMIN_SUBDOMAIN.
# Alias del formulario; no sustituye la autenticación.
ADMIN_LOGIN_PATH=/portal-interno

# El login no crea usuarios desde variables. Importar explícitamente el JSON privado.
# Mantener AUTH_SECRET para conservar las sesiones existentes.

# PostgreSQL/Neon: usar conexiones privadas del proyecto (no valores de ejemplo en producción).
DATABASE_URL=
DIRECT_URL=

# Solo herramientas locales de importación, nunca necesarias en Vercel:
# STAFF_IMPORT_DATABASE_URL=
# STAFF_IMPORT_EXPECT_HOST=
