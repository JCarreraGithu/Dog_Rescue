# Copia este archivo como .env (local) y configura las mismas variables en Render.
# NUNCA subas el archivo .env a GitHub.

# Texto largo y aleatorio (32+ caracteres) para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=pega-aqui-el-texto-aleatorio

# Subdominio exclusivo para administración (ej. interno.localhost:3000 o interno.tu-dominio.org)
ADMIN_SUBDOMAIN=interno

# Dominios adicionales autorizados en producción (ej. panel-privado-refugio.onrender.com)
ADMIN_ALLOWED_HOSTS=

# Ruta SECRETA del login del personal dentro del subdominio interno
ADMIN_LOGIN_PATH=/elige-una-ruta-dificil-de-adivinar

# Primer administrador total (solo se usa la primera vez; se obliga a cambiar la contraseña)
ADMIN_EMAIL=admin@tu-refugio.org
ADMIN_PASSWORD=una-contraseña-temporal
