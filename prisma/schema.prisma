   datasource db {
     provider  = "postgresql"
     url       = env("DATABASE_URL")
     directUrl = env("DIRECT_URL")
   }

generator client {
  provider = "prisma-client-js"
}


model Dog {
  id               String                @id @default(uuid())
  name             String
  breed            String                @default("Mestizo")
  ageCategory      String
  ageYears         Float                 @default(1.0)
  gender           String
  size             String
  temperament      String
  status           String                @default("En Adopción")
  rescueHistory    String
  healthNotes      String
  photoUrl         String
  isSterilized     Boolean               @default(false)
  rescueDate       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // Eliminación lógica: conserva el expediente en Neon
  isDeleted        Boolean               @default(false)
  deletedAt        DateTime?
  documentation    Json?
  isArchived       Boolean @default(false)

  medicalRecords   MedicalRecord[]
  applications     AdoptionApplication[]
}


model MedicalRecord {
  id          String    @id @default(uuid())
  dogId       String
  dog         Dog       @relation(fields: [dogId], references: [id], onDelete: Cascade)
  type        String    // Vacuna, Desparasitación, Esterilización, Consulta, Tratamiento
  title       String
  description String
  date        DateTime
  vetName     String    @default("Dr. Veterinario Amatitlán")
  nextDueDate DateTime?
  status      String    @default("Completado") // Completado, Pendiente, Programado
  createdAt   DateTime  @default(now())
}


model AdoptionApplication {
  id              String    @id @default(uuid())
  dogId           String?
  dog             Dog?      @relation(fields: [dogId], references: [id], onDelete: SetNull)
  dogSnapshot     Json?

  // Información inicial del solicitante
  applicantName   String
  applicantAge    Int?
  applicantPhone  String

  // Condiciones de la vivienda
  petsAllowed     Boolean?
  safeHome        Boolean?
  enoughSpace     Boolean?
  petAccess       String?   // Todos, Algunos

  // Bienestar animal
  knowsFiveFreedoms   Boolean?
  commitsToWelfare    Boolean?
  commitsToSterilize  Boolean?

  // Evaluación administrativa
  status          String    @default("Pendiente")
  evaluatorNotes  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
    // Campos antiguos: se conservan durante la migración
  applicantEmail    String   @default("")
  applicantAddress  String   @default("")
  homeType          String   @default("Casa")
  hasYard           Boolean  @default(false)
  hasOtherPets      Boolean  @default(false)
}


model InventoryItem {
  id           String   @id @default(uuid())
  category     String   // Concentrado, Medicamento, Insumo de Limpieza
  name         String
  quantity     Float
  unit         String   // kg, costales, unidades, frascos, cajas
  minThreshold Float    @default(5)
  lastUpdated  DateTime @updatedAt
}


model Volunteer {
  id           String   @id @default(uuid())
  name         String
  email        String   @default("")
  phone        String

  // Datos del formulario de postulación
  age          Int?
  municipality String?
  availableDays String[] @default([])
  commitmentDuration String?
  interestAreas String[] @default([])
  animalExperience String?
  motivation   String?
  acceptsSafetyRules Boolean?
  authorizesDataUse  Boolean?

  // Campos del sistema anterior: se conservan
  saturdayDate String   @default("")
  assignedTask String   @default("Cuidado General")

  // En Evaluación, Aprobado, Rechazado
  // Los registros anteriores conservan su estado Confirmado
  status       String   @default("En Evaluación")
  evaluatorNotes String?
  createdAt    DateTime @default(now())
}


model CaseReport {
  id              String   @id @default(uuid())
  reporterName    String
  reporterPhone   String
  locationAddress String   // Amatitlán, Guatemala
  description     String
  photoUrl        String?
  photos          String[] @default([])
  adminNotes      String   @default("")
  urgencyLevel    String   @default("Media") // Alta, Media, Baja
  status          String   @default("Recibido") // Recibido, En Revisión, Rescatado, Descartado
  createdAt       DateTime @default(now())
}

model TransparencyStat {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Int
  label     String
  updatedAt DateTime @updatedAt
}

enum StaffRole {
  superadmin
  editor
  voluntario
}

model StaffUser {
  id                 String    @id
  name               String
  email              String    @unique
  role               StaffRole
  passwordHash       String
  active             Boolean
  mustChangePassword Boolean
  sessionVersion     Int
  createdAt          DateTime  @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
}

// Snapshot del actor: el historial no depende de que su cuenta siga existiendo.
model AuditLog {
  id        String   @id @default(uuid())
  at        DateTime @default(now()) @db.Timestamptz(3)
  actor     String
  actorName String?
  action    String
  detail    String?
  ip        String?

  @@index([at])
}

model LoginAttempt {
  key       String   @id
  count     Int
  resetAt   DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  targetTab String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  metadata  Json?

  @@index([createdAt, id])
}

model HomeSettings {
  id             String   @id
  badgeText      String
  mottoPart1     String
  mottoHighlight String
  description    String
  button1Text    String
  button2Text    String
  fontFamily     String
  fontWeight     String
  fontStyle      String
  textTransform  String
  fontSize       String
  highlightColor String
  textAlignment  String
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model StoreOrder {
  id               String   @id @default(uuid())
  customerName     String
  customerPhone    String
  deliveryMethod   String
  department       String   @default("")
  shippingAddress  String   @default("")
  shippingFee      Float
  paymentMethod    String
  paymentReference String   @default("")
  paymentStatus    String   @default("Pendiente")
  trackingNumber   String   @default("")
  adminNotes       String   @default("")
  note             String   @default("")
  items            Json
  subtotal         Float
  total            Float
  status           String   @default("Pendiente")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
}

// Fotos de reportes: bytea persistente; cargas divididas para respetar el límite HTTP de Vercel.
model ReportImage {
  id              String   @id @default(uuid())
  content         Bytes
  contentType     String
  totalSize       Int
  received        Int
  uploadTokenHash String?
  isPrivate       Boolean @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
}

model StoreProduct {
  id           String @id @default(uuid())
  name         String
  description  String
  price        Float
  category     String
  variantLabel String?
  variants     String[] @default([])
  image        String?
  stock        Int @default(0)
  available    Boolean @default(true)
  featured     Boolean @default(false)
  badge        String?
  isDeleted    Boolean @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([isDeleted, createdAt])
}

model AboutSettings {
  id                  String @id
  heroImage           String
  heroBadgeText       String
  heroCaptionTitle    String
  heroCaptionSubtitle String
  carousel            Json?
  family              Json?
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model SpecialCase {
  id         String   @id @default(uuid())
  name       String   @default("")
  title      String
  subtitle   String   @default("")
  story      String
  beforeText String   @default("")
  afterText  String   @default("")
  location   String   @default("Amatitlán, Guatemala")
  date       String   @default("")
  status     String   @default("Caso Éxito")
  image      String
  gallery    String[] @default([])
  video      String   @default("")
  featured   Boolean  @default(true)
  published  Boolean  @default(true)
  draft      Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  deletedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([isDeleted, createdAt])
}
